{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeseries.schema.json",
  "type": "object",
  "required": [
    "interval",
    "points"
  ],
  "properties": {
    "interval": {
      "enum": [
        "hour",
        "day",
        "week",
        "month"
      ]
    },
    "tz": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t",
          "value"
        ],
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "number"
          }
        }
      }
    }
  }
}
