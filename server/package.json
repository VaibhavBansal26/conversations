{
  "name": "conversations-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/seed.ts",
    "e2e": "node scripts/e2e.mjs",
    "admin": "tsx scripts/platform-admin.ts",
    "docs:config": "tsx scripts/gen-config-doc.ts",
    "docs:api": "tsx scripts/gen-api-doc.ts",
    "docs:realtime": "tsx scripts/gen-realtime-doc.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "docs:ratelimit": "tsx scripts/gen-ratelimit-doc.ts",
    "docs:analytics-schemas": "tsx scripts/gen-analytics-schemas.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^2.1.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.17",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^26.1.0",
    "mermaid": "^11.17.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
