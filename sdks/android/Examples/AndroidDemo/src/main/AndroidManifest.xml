<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- optional: adds "take a photo" to the attach button; without it only the file and photo pickers are offered -->
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:label="Conversations demo" android:usesCleartextTraffic="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- usesCleartextTraffic is for http://10.0.2.2 during development only: remove it in a real app -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
