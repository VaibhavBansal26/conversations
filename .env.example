# Copy to server/.env (or export in the shell). Every value has a safe development default; nothing here is a real credential.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL of this server. Used in webhook signature checks, signed file links and emails.
PUBLIC_URL=http://localhost:3000
# Comma separated browser origins allowed to call the team API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# REQUIRED in production (>= 16 chars). In development a random secret is generated at boot with a warning.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=43200

# Storage
DATABASE_PATH=./data/conversations.db
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900
# Built web app to serve (defaults to ../web/dist next to the server).
WEB_DIST=

# Realtime. "redis" needs: npm i @socket.io/redis-adapter redis  (optional dependencies) and REDIS_URL.
SOCKET_ADAPTER=memory
REDIS_URL=
PRESENCE_GRACE_MS=5000

# Providers. "console" logs and stores messages in memory (development default).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
# SendGrid signed event webhook public key (base64 SPKI). Without it the shared secret below is used.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Shared secret for SendGrid inbound parse / event fallback (?secret=... or x-webhook-secret header).
WEBHOOK_SHARED_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300
SYSTEM_EMAIL_FROM=notifications@conversations.local
CREDIT_COST_SMS=1
CREDIT_COST_EMAIL=1

# AI. Without a key the offline heuristic provider is used (every feature still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=20000

# Background work
SCHEDULER_ENABLED=true
SEND_RETRY_MAX_ATTEMPTS=5
SEND_RETRY_BASE_SECONDS=30
SEND_RETRY_CAP_SECONDS=3600
DIGEST_MIN_AGE_MINUTES=2
DIGEST_MAX_AGE_MINUTES=60

SOCKET_RATE_PER_SEC=10
SOCKET_RATE_BURST=30
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
