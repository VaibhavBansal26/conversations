# Copy to server/.env (or export in the shell). Every value has a safe development default; nothing here is a real credential.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL of this server. Used in webhook signature checks, signed file links and emails.
PUBLIC_URL=http://localhost:3000
# Comma separated browser origins allowed to call the team API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# REQUIRED in production (>= 16 chars). In development a random secret is generated at boot with a warning.
JWT_SECRET=
# Access tokens are short; clients renew them with a single-use refresh token (30 days).
ACCESS_TOKEN_TTL_SECONDS=900

# Storage
DATABASE_PATH=./data/conversations.db
DATA_DIR=./data
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900
# Built web app to serve (defaults to ../web/dist next to the server).
WEB_DIST=

# Scale-out. Both are auto-detected: leave empty for the single-node default (SQLite file + in-process everything).
# DATABASE_URL=postgres://user:pass@host:5432/conversations   -> PostgreSQL (multi-node)
DATABASE_URL=
DATABASE_POOL_MAX=10
# REDIS_URL=redis://host:6379   -> shared socket fan-out, presence, rate limits, cache invalidation, locks, delayed jobs
REDIS_URL=
REDIS_PREFIX=conv
SOCKET_ADAPTER=auto
JOB_QUEUE=auto
# Unique per node (defaults to hostname + random suffix); shows up in logs and metrics.
NODE_ID=
CACHE_TTL_MS=3000

# Realtime / WebSocket limits. 0 = unlimited where noted.
PRESENCE_GRACE_MS=5000
PRESENCE_TTL_MS=30000
WS_PING_INTERVAL_MS=25000
WS_PING_TIMEOUT_MS=20000
WS_MAX_BUFFER_BYTES=262144
WS_MAX_CONNECTIONS=0
WS_MAX_CONNECTIONS_PER_IP=0
WS_CONNECT_RATE_PER_IP=20
WS_MAX_WRITE_BUFFER=500
WS_DRAIN_MS=5000
WS_PERMESSAGE_DEFLATE=false
WS_TRANSPORTS=polling,websocket

# Behind Cloudflare: believe CF-Connecting-IP only when the request also carries X-Edge-Secret equal to this. See docs/CLOUDFLARE.md.
CF_SHARED_SECRET=

# Operations
REQUEST_TIMEOUT_MS=30000
# Bearer token required for GET /metrics (unset = open; only expose /metrics on a private network).
METRICS_TOKEN=
WORKER_POOL_SIZE=2
# LOAD TESTING ONLY: multiplies every rate limit. Must stay 1 in production.
RATE_LIMIT_SCALE=1
# Optional tracing: set the endpoint and install @opentelemetry/sdk-node + @opentelemetry/auto-instrumentations-node
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318

# Providers. "console" logs and stores messages in memory (development default).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
# SendGrid signed event webhook public key (base64 SPKI). Without it the shared secret below is used.
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Shared secret for SendGrid inbound parse / event fallback (?secret=... or x-webhook-secret header).
WEBHOOK_SHARED_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300
SYSTEM_EMAIL_FROM=notifications@conversations.local
CREDIT_COST_SMS=1
CREDIT_COST_EMAIL=1

# Billing (Stripe). Unset = billing off; the app still runs. See docs/STRIPE.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
BILLING_GRACE_DAYS=7
CREDIT_PRICE_CENTS=2
BILLING_CURRENCY=usd
CONNECT_APPLICATION_FEE_BPS=0
# Enforce plan seat limits, plan socket caps and the soft lock after a failed payment.
PLAN_ENFORCEMENT=false

# Scale-out data layer (PostgreSQL only). See docs/SCALING.md.
# MESSAGE_HASH_PARTITIONS is read once, when the partitioning migration first runs; it cannot change afterwards.
MESSAGE_HASH_PARTITIONS=16
# DATABASE_PGBOUNCER=true when a transaction-mode PgBouncer sits in front of PostgreSQL.
DATABASE_PGBOUNCER=false
DATABASE_REPLICA_URL=

# AI. Without a key the offline heuristic provider is used (every feature still works).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=20000

# Background work
SCHEDULER_ENABLED=true
SEND_RETRY_MAX_ATTEMPTS=5
SEND_RETRY_BASE_SECONDS=30
SEND_RETRY_CAP_SECONDS=3600
DIGEST_MIN_AGE_MINUTES=2
DIGEST_MAX_AGE_MINUTES=60

SOCKET_RATE_PER_SEC=10
SOCKET_RATE_BURST=30
BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info

# optional error monitoring (docs/MONITORING.md); off while SENTRY_DSN is empty
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
